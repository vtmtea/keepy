{
  "name": "keepy",
  "version": "0.1.0",
  "description": "Windows tray utility that keeps the mouse active on a configurable schedule.",
  "main": "./out/main/index.js",
  "author": "Keepy",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "build": {
    "appId": "com.keepy.desktop",
    "productName": "Keepy",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Keepy-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
